{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tingo",
  "version": "0.5.4",
  "identifier": "io.github.tancheng33.tingo",
  "build": {
    "frontendDist": "../../src/tingo/web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tingo 听过",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 680,
        "backgroundColor": "#FAFAFC",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "本地中文会议纪要",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "bin/tingo-recorder": "tingo-recorder",
      "../../src/tingo/sample": "sample"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNjBEOEIxMTlEMzRDNTMKUldSVFROTVpzZGhndnlWUVJVdGpoMXh3dHJCYmFETVBkQkJzRkRaTmtjMEdGYXpPWmhSMFlJaXEK",
      "endpoints": [
        "https://github.com/tancheng33/tingo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
